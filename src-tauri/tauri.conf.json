{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "便签",
  "version": "0.1.0",
  "identifier": "com.bianqian.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "便签",
        "width": 422,
        "height": 540,
        "minWidth": 422,
        "minHeight": 540,
        "resizable": true,
        "maximizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:bianqian.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
