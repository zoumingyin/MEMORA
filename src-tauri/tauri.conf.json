{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEMORA",
  "mainBinaryName": "MEMORA",
  "version": "1.2.0",
  "identifier": "com.bianqian.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MEMORA",
        "width": 422,
        "height": 540,
        "minWidth": 422,
        "minHeight": 540,
        "resizable": true,
        "maximizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "MEMORA",
        "url": "splash.html",
        "width": 560,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2NDlEQzY5OEEyQzdGQTMKUldTamZ5eUthZHhKaGlldTJDbUc4aHdjVkNZa3VyR0FDQkhBS1RDQ2dhRHNsWDNwQWowbHZwNGIK",
      "endpoints": [
        "https://gitee.com/zoumingyin/MEMORA/releases/download/latest/latest.json",
        "https://github.com/zoumingyin/MEMORA/releases/latest/download/latest.json"
      ]
    }
  }
}
