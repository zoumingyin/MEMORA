{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "md-ctx-menu",
  "description": "Markdown 右键菜单窗口能力：显示/聚焦/关闭自身窗口，事件通信（emit 命令回传主窗口）",
  "windows": ["md-ctx-*"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
